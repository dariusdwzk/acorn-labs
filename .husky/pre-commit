npx lint-staged
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact --config .gitleaks.toml
else
  echo "warning: gitleaks not installed locally (brew install gitleaks); CI will still scan."
fi
# Keep docs/PROGRESS.md and docs/HANDOVER.md current whenever code changes.
[ -n "$SKIP_DOCS_CHECK" ] || git diff --cached --name-only | node scripts/docs-check.mjs || exit 1
